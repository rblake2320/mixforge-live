HOST=127.0.0.1
PORT=4173
PUBLIC_BASE_URL=http://127.0.0.1:4173
JWT_SECRET=replace-this-with-a-long-random-secret
ALLOWED_ORIGINS=

# Development defaults to demo mode; production defaults to false.
# Demo mode is useful for sales/testing, but /api/readiness will not pass until it is false and real providers are configured.
MIXFORGE_DEMO_MODE=

# Required for real paid checkout. Without these, paid checkout only works as a labeled demo when MIXFORGE_DEMO_MODE=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_DJ_PRO=
STRIPE_PRICE_LABEL=

# Required for real stem separation. Without these, stem jobs only work as labeled demos when MIXFORGE_DEMO_MODE=true.
STEMSPLIT_API_KEY=
STEMSPLIT_WEBHOOK_SECRET=

# Self-hosted stem engine (stem-engine/engine.py, runs Demucs on a local GPU).
# When STEM_ENGINE_URL is set it takes precedence over StemSplit and satisfies
# the stem-separation readiness check. YouTube/SoundCloud link import stays a
# hosted-StemSplit feature; the engine handles uploads and direct audio URLs.
#   python -m uvicorn engine:app --host 127.0.0.1 --port 9077   (from stem-engine/)
STEM_ENGINE_URL=
STEM_ENGINE_API_KEY=

# Optional. Local defaults live under ./data. In production, defaults live under /data.
# On Railway, mount a Volume at /data for persistence.
MIXFORGE_DATA_ROOT=
MIXFORGE_DATA_FILE=
MIXFORGE_UPLOAD_ROOT=
MIXFORGE_LOG_ROOT=
MIXFORGE_LOG_RETENTION_DAYS=90
MIXFORGE_SLOW_REQUEST_MS=1000

# Persistence backend. Default is the flat-file JsonStore (single-node). Set
# DATABASE_URL to a Postgres instance for the scalable, multi-instance backend
# (auto-selected when DATABASE_URL is present; force with MIXFORGE_STORE=postgres).
DATABASE_URL=
MIXFORGE_STORE=

# Rate limiting. Without REDIS_URL, limits are in-memory (per-process, reset on
# restart). Set REDIS_URL so limits hold across instances and restarts.
REDIS_URL=

# Moderation / Trust & Safety. Required to use the /api/moderation/* endpoints.
MIXFORGE_ADMIN_TOKEN=
MIXFORGE_DMCA_AGENT_EMAIL=dmca@mixforge.live

# Upload storage. Default is local disk. Set S3_BUCKET (+ credentials) to store
# uploads in S3 or any S3-compatible object store (R2, MinIO) and serve via
# pre-signed URLs. Auto-selected when S3_BUCKET is set; force with MIXFORGE_STORAGE=s3.
MIXFORGE_STORAGE=
S3_BUCKET=
S3_PREFIX=uploads
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
