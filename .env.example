HOST=127.0.0.1
PORT=4173
PUBLIC_BASE_URL=http://127.0.0.1:4173
JWT_SECRET=replace-this-with-a-long-random-secret
ALLOWED_ORIGINS=

# Development defaults to demo mode; production defaults to false.
# Demo mode is useful for sales/testing, but /api/readiness will not pass until it is false and real providers are configured.
MIXFORGE_DEMO_MODE=

# Required for real paid checkout. Without these, paid checkout only works as a labeled demo when MIXFORGE_DEMO_MODE=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_DJ_PRO=
STRIPE_PRICE_LABEL=

# Required for real stem separation. Without these, stem jobs only work as labeled demos when MIXFORGE_DEMO_MODE=true.
STEMSPLIT_API_KEY=
STEMSPLIT_WEBHOOK_SECRET=

# Optional. Local defaults live under ./data. In production, defaults live under /data.
# On Railway, mount a Volume at /data for persistence.
MIXFORGE_DATA_ROOT=
MIXFORGE_DATA_FILE=
MIXFORGE_UPLOAD_ROOT=
